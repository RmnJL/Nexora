[Unit]
Description=Nexora Forward Client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/nexora/src
Environment="NEXORA_CLIENT_PY=/root/nexora/src/nexora_client.py"
Environment="NEXORA_RESOLVERS=185.49.84.2,178.22.122.100"
Environment="NEXORA_PORT=53"
Environment="NEXORA_ZONE=t1.phonexpress.ir"
Environment="NEXORA_QTYPE=TXT"
Environment="NEXORA_TIMEOUT=3"
Environment="NEXORA_ATTEMPTS=5"
Environment="NEXORA_RESOLVER_FAIL_COOLDOWN=5"
Environment="NEXORA_RESOLVER_HEALTH_INTERVAL=120"
Environment="NEXORA_RESOLVER_SWITCH_INTERVAL=300"
Environment="NEXORA_RESOLVER_PROBE_TIMEOUT=1.6"
Environment="NEXORA_RESOLVER_PROBE_QTYPE=TXT"
Environment="NEXORA_TCP_CHUNK_SIZE=100"
Environment="NEXORA_FORWARD_LISTEN_HOST=0.0.0.0"
Environment="NEXORA_FORWARD_LISTEN_PORT=1443"
Environment="NEXORA_FORWARD_TARGET_HOST=127.0.0.1"
Environment="NEXORA_FORWARD_TARGET_PORT=8443"
Environment="NEXORA_FORWARD_MAX_CONNS=2"
Environment="NEXORA_FORWARD_MAX_CONNS_PER_IP=64"
Environment="NEXORA_STREAM_OPEN_RETRIES=2"
Environment="NEXORA_DNS_QUERY_INTERVAL=0.02"
Environment="NEXORA_PIPELINE_DEPTH=2"
Environment="NEXORA_RESOLVER_FILE=/etc/nexora/resolvers.json"
Environment="NEXORA_FORWARD_POLL_MIN_INTERVAL=0.12"
Environment="NEXORA_FORWARD_POLL_MAX_INTERVAL=3.0"
Environment="NEXORA_FORWARD_IDLE_TIMEOUT=10"
ExecStart=/usr/bin/python3 -u ${NEXORA_CLIENT_PY} --server ${NEXORA_RESOLVERS} --port ${NEXORA_PORT} --zone ${NEXORA_ZONE} --qtype ${NEXORA_QTYPE} --timeout ${NEXORA_TIMEOUT} --attempts ${NEXORA_ATTEMPTS} --resolver-fail-cooldown ${NEXORA_RESOLVER_FAIL_COOLDOWN} --resolver-health-interval ${NEXORA_RESOLVER_HEALTH_INTERVAL} --resolver-switch-interval ${NEXORA_RESOLVER_SWITCH_INTERVAL} --resolver-probe-timeout ${NEXORA_RESOLVER_PROBE_TIMEOUT} --resolver-probe-qtype ${NEXORA_RESOLVER_PROBE_QTYPE} --tcp-chunk-size ${NEXORA_TCP_CHUNK_SIZE} --forward-listen-host ${NEXORA_FORWARD_LISTEN_HOST} --forward-listen-port ${NEXORA_FORWARD_LISTEN_PORT} --forward-target-host ${NEXORA_FORWARD_TARGET_HOST} --forward-target-port ${NEXORA_FORWARD_TARGET_PORT} --forward-max-conns ${NEXORA_FORWARD_MAX_CONNS} --forward-max-conns-per-ip ${NEXORA_FORWARD_MAX_CONNS_PER_IP} --stream-open-retries ${NEXORA_STREAM_OPEN_RETRIES} --dns-query-interval ${NEXORA_DNS_QUERY_INTERVAL} --forward-poll-min-interval ${NEXORA_FORWARD_POLL_MIN_INTERVAL} --forward-poll-max-interval ${NEXORA_FORWARD_POLL_MAX_INTERVAL} --forward-idle-timeout ${NEXORA_FORWARD_IDLE_TIMEOUT} --pipeline-depth ${NEXORA_PIPELINE_DEPTH} --resolver-file ${NEXORA_RESOLVER_FILE}
Restart=always
RestartSec=2
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
